# Chess Coach — environment configuration template.
# Copy this file to `.env` and fill in the secrets. `.env` is gitignored.

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Lichess Opening Explorer ---
# The Explorer now requires an authenticated token. Without one, the agent
# falls back to the bundled local opening book. Create a token (no scope needed)
# at https://lichess.org/account/oauth/token (see GUIDE_UTILISATEUR.md).
LICHESS_EXPLORER_BASE=https://explorer.lichess.ovh
LICHESS_API_BASE=https://lichess.org
LICHESS_TOKEN=

# --- Stockfish engine ---
# Inside Docker the binary is installed system-wide at /usr/games/stockfish.
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_DEPTH=15
STOCKFISH_THREADS=1

# --- YouTube Data API v3 ---
# Create a key at https://console.cloud.google.com/ (see GUIDE_UTILISATEUR.md).
YOUTUBE_API_KEY=replace-me-with-your-youtube-data-api-key

# --- Milvus vector database ---
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=chess_openings

# --- Embedding model (sentence-transformers) ---
# Multilingual (the Wikichess knowledge base is in French); the brief also
# suggests Qwen3-Embedding-0.6B.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- MongoDB ---
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=chess_coach

# --- Optional LLM synthesis layer (OpenAI-compatible) ---
# When LLM_ENABLED=false the agent returns a deterministic French template.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
